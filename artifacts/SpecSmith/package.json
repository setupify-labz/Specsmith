{
  "name": "@workspace/specsmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && node scripts/prerender.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:benchmarks": "vitest run src/lib/benchmarks/validate.test.ts",
    "collect:measured": "tsx scripts/measured/collect.ts",
    "content:strategist": "tsx scripts/content-automator/run.ts",
    "content:automator": "tsx scripts/content-automator/run.ts",
    "content:trends:refresh": "tsx scripts/content-automator/refreshAudioTrends.ts",
    "content:render:dry-run": "tsx scripts/content-automator/renderDryRun.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.2",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "qrcode.react": "^4.2.0"
  }
}
