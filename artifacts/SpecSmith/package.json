    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "framer-motion": "catalog:",
    "jsdom": "^30.0.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.2",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "qrcode.react": "^4.2.0"
  }
