    "test:cancel-harness": "tsx scripts/measured/__fixtures__/cancelHarness.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
