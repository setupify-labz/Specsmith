{
  "name": "@workspace/specsmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && node scripts/check-performance-budget.mjs && node scripts/prerender.mjs && node scripts/check-static-seo.mjs",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "check:seo": "node scripts/check-static-seo.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:benchmarks": "vitest run src/lib/benchmarks/validate.test.ts",
    "collect:measured": "tsx scripts/measured/collect.ts",
    "test:cancel-harness": "tsx scripts/measured/__fixtures__/cancelHarness.ts",
    "content:strategist": "tsx scripts/content-automator/run.ts",
    "content:automator": "tsx scripts/content-automator/run.ts",
    "content:trends:refresh": "tsx scripts/content-automator/refreshAudioTrends.ts",
    "content:tts:smoke": "tsx scripts/content-automator/ttsSmokeTest.ts",
    "content:video:smoke": "tsx scripts/content-automator/videoGenerationSmoke.ts",
    "content:render:dry-run": "tsx scripts/content-automator/renderDryRun.ts",
    "content:render:ui-smoke": "tsx scripts/content-automator/uiRender/smokeRender.ts",
    "content:render:mp4-smoke": "tsx scripts/content-automator/compositorSmoke.ts",
    "content:render:mp4-smoke:offline": "tsx scripts/content-automator/offlineCompositorSmoke.ts",
    "content:meshy:ingest": "tsx scripts/content-automator/meshyIngestCli.ts",
    "content:e2e:offline": "tsx scripts/content-automator/endToEndOfflinePipeline.ts",
    "content:metricool:live-smoke": "tsx scripts/content-automator/metricoolLiveSmoke.ts",
    "content:analytics:pass": "tsx scripts/content-automator/analyticsPassCli.ts",
    "audit:retailer-links": "tsx scripts/retail/audit/audit-retailer-links.ts",
    "content:creative:brief": "tsx scripts/content-automator/creativeFileWorkflowCli.ts brief",
    "content:creative:review": "tsx scripts/content-automator/creativeFileWorkflowCli.ts review"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "framer-motion": "catalog:",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "lucide-react": "catalog:",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "qrcode.react": "^4.2.0"
  }
}
