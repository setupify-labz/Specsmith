{
  "$comment": "One CreativeConcept per file, in batches/attempt-<n>/. Exactly three files per attempt. Beats must be contiguous: each beat's startSecond equals the previous beat's endSecond, and the first starts at 0.",
  "type": "object",
  "required": [
    "conceptId",
    "axes",
    "viewerQuestion",
    "viewerTakeaway",
    "visuals",
    "beats",
    "requiredCapabilities",
    "productDestination",
    "requiredDisclosures",
    "disclosureTextByBeat"
  ],
  "properties": {
    "conceptId": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "object",
      "required": [
        "audienceExperience",
        "explanatoryStructure",
        "visualMechanism"
      ],
      "properties": {
        "audienceExperience": {
          "enum": [
            "spectator",
            "investigator",
            "participant"
          ]
        },
        "explanatoryStructure": {
          "enum": [
            "continuum-then-falsification",
            "elimination-then-substitution",
            "branch-no-ranking",
            "linear-demonstration",
            "prediction-then-reveal",
            "question-evidence-boundary"
          ]
        },
        "visualMechanism": {
          "enum": [
            "animated-product-walk",
            "annotated-static-card",
            "split-screen-fork",
            "single-surface-hold"
          ]
        }
      }
    },
    "viewerQuestion": {
      "type": "string",
      "minLength": 1
    },
    "viewerTakeaway": {
      "type": "string",
      "minLength": 1
    },
    "productDestination": {
      "const": "/compare"
    },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "$comment": "This production adapter renders the validated Compare capture and data motion graphics computed from the primary view. A declared illustration stays blocked rather than being silently replaced.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "visualId",
              "surface",
              "stateIdentifier"
            ],
            "properties": {
              "kind": {
                "const": "real-product-capture"
              },
              "surface": {
                "const": "compare"
              },
              "stateIdentifier": {
                "enum": [
                  "compare_rtx5070_r5-7600_vs_rtx4060_r5-7600_1440p_high_static_540x960-2"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "visualId",
              "template",
              "sourceStateIdentifier",
              "games",
              "baseline"
            ],
            "properties": {
              "kind": {
                "const": "data-motion-graphic"
              },
              "template": {
                "enum": [
                  "upgrade-intro",
                  "game-labels",
                  "fps-change",
                  "percent-change"
                ]
              },
              "sourceStateIdentifier": {
                "const": "compare_rtx5070_r5-7600_vs_rtx4060_r5-7600_1440p_high_static_540x960-2"
              },
              "games": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "cyberpunk2077",
                    "msfs2024",
                    "rdr2",
                    "fortnite",
                    "valorant",
                    "cs2",
                    "apex",
                    "warzone",
                    "eldenring",
                    "hogwarts",
                    "gtav",
                    "witcher3",
                    "starfield",
                    "alanwake2",
                    "spiderman2",
                    "bg3",
                    "r6siege",
                    "minecraft",
                    "dyinglight2",
                    "acmirage"
                  ]
                }
              },
              "baseline": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "stage": {
                "enum": [
                  "reveal",
                  "explain",
                  "ask"
                ]
              }
            }
          }
        ]
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "purpose",
          "startSecond",
          "endSecond",
          "narration",
          "onScreenText",
          "visualIds",
          "factDependencies"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "hook",
              "commitment",
              "evidence",
              "reversal",
              "payoff",
              "cta"
            ]
          },
          "startSecond": {
            "type": "number",
            "minimum": 0
          },
          "endSecond": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "factDependencies": {
            "type": "array",
            "items": {
              "enum": [
                "gpu-upgrade-gpu-heavy-game",
                "gpu-upgrade-cpu-heavy-game",
                "gpu-upgrade-percent-gpu-heavy-game",
                "gpu-upgrade-percent-cpu-heavy-game",
                "bigger-percentage-boost",
                "model-weights-games",
                "rtx5070-higher-in-every-game"
              ]
            },
            "$comment": "At least one beat must carry an approved claimId. No other id is accepted."
          }
        }
      }
    },
    "requiredDisclosures": {
      "type": "array",
      "items": {
        "enum": [
          "disclosure.fps-estimate"
        ]
      }
    },
    "disclosureTextByBeat": {
      "type": "object",
      "$comment": "Keys are beat indices as strings. Every beat that shows a product capture must list the exact disclosure text verbatim. A disclosure promised by id but absent from the beat is rejected.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
